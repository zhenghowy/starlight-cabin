.nav {
  position: fixed;
  left: 0; right: 0; top: 0;
  z-index: 20;
  box-sizing: border-box;
  background: #2e4a62;
  color: #fffdf7;
}
.nav-inner { position: relative; display: flex; align-items: center; }
.nav-sync, .nav-leave {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  color: rgba(255, 253, 247, 0.88);
  padding: 8rpx 20rpx;
}
.nav-leave { margin-left: auto; }
.nav-title {
  position: absolute;
  left: 140rpx;
  right: 140rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}
